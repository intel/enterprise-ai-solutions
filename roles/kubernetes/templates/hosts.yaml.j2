# Auto-generated from nodes.yaml — DO NOT EDIT MANUALLY
# Re-generated each run when nodes.yaml defines control_plane/workers.
all:
    hosts:
{% for node in _nodes_control_plane + _nodes_workers %}
        {{ node.hostname }}:
{% if node.hostname == 'localhost' or node.ip | string is match('^(127[.]|::1$|localhost$)') %}
            # The installer machine itself: no SSH, and the installer's Python.
            ansible_connection: local
            ansible_python_interpreter: "{% raw %}{{ ansible_playbook_python }}{% endraw %}"
{% else %}
            ansible_host: {{ node.ip }}
            ansible_user: {{ node.ssh_user | default(_nodes_ssh_user) }}
{% if node.ssh_key is defined or _nodes_ssh_key | default('') | length > 0 %}
            ansible_ssh_private_key_file: {{ node.ssh_key | default(_nodes_ssh_key) }}
{% endif %}
{% endif %}
{% endfor %}
    children:
        kube_control_plane:
            hosts:
{% for node in _nodes_control_plane %}
                {{ node.hostname }}: {}
{% endfor %}
        kube_node:
            hosts:
{% if _nodes_workers | length > 0 %}
{% for node in _nodes_workers %}
                {{ node.hostname }}: {}
{% endfor %}
{% else %}
{% for node in _nodes_control_plane %}
                {{ node.hostname }}: {}
{% endfor %}
{% endif %}
        etcd:
            children:
                kube_control_plane:
        nfs_server:
            hosts:
                {{ _nodes_control_plane[0].hostname }}: {}
        k8s_cluster:
            children:
                kube_control_plane:
                kube_node:
            vars:
                ansible_become: true
                # The playbooks run with connection: local; delegated node tasks need SSH.
                # A localhost node overrides both below in its host vars.
                ansible_connection: ssh
                ansible_python_interpreter: /usr/bin/python3
        calico_rr:
            hosts: {}
