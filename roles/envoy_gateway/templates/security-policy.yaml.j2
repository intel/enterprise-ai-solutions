---
# Gateway-wide auth. Only keycloak attaches a policy here: it validates the
# Keycloak-issued JWT for every route on the gateway. In litellm mode the gateway
# does TLS + routing only — LiteLLM (litellm.<domain>) validates its own virtual
# keys and is the sole inference auth boundary — so no gateway policy is applied
# (see roles/envoy_gateway/tasks/install.yaml).
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: SecurityPolicy
metadata:
  name: gateway-auth
  namespace: {{ gateway_namespace }}
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: {{ gateway_name }}
  jwt:
    providers:
      - name: keycloak
        issuer: "https://{{ keycloak_hostname }}/realms/{{ keycloak_realm }}"
        audiences:
          - "{{ keycloak_client_id | default('inference-client') }}"
        remoteJWKS:
          uri: "http://keycloak-service.{{ keycloak_namespace | default('keycloak') }}.svc.cluster.local:8080/realms/{{ keycloak_realm }}/protocol/openid-connect/certs"
