---
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: SecurityPolicy
metadata:
  name: gateway-auth
  namespace: {{ gateway_namespace }}
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: {{ gateway_name }}
{# Deny-by-default in both auth modes: a route without its own SecurityPolicy
   needs a Keycloak JWT. Routes that authenticate elsewhere (UI logins, LiteLLM
   virtual keys) attach their own policy, which overrides this one. #}
{% if keycloak_enabled | default(true) | bool %}
  jwt:
    providers:
      - name: keycloak
        issuer: "https://{{ keycloak_hostname }}/realms/{{ keycloak_realm }}"
        audiences:
          - "{{ keycloak_client_id | default('inference-client') }}"
        remoteJWKS:
          uri: "http://keycloak-service.{{ keycloak_namespace | default('keycloak') }}.svc.cluster.local:8080/realms/{{ keycloak_realm }}/protocol/openid-connect/certs"
{% else %}
  # Keycloak turned off: nothing can present a token, so refuse outright.
  authorization:
    defaultAction: Deny
{% endif %}
