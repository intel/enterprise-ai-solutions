---
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: SecurityPolicy
metadata:
  name: gateway-auth
  namespace: {{ gateway_namespace }}
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: {{ gateway_name }}
{% if auth_provider == 'keycloak' %}
  jwt:
    providers:
      - name: keycloak
        # Issuer must equal the token's iss claim = Keycloak's external frontend
        # URL. In path mode that carries /keycloak (frontend_url from the shared
        # service_route filter); in subdomain mode it is https://keycloak.<base>.
        issuer: "{{ keycloak_route.frontend_url }}/realms/{{ keycloak_realm }}"
        audiences:
          - "{{ keycloak_client_id | default('inference-client') }}"
        remoteJWKS:
          # In-cluster fetch of the signing keys. http-relative-path also shifts
          # the in-cluster serving path, so the prefix ('/keycloak' in path mode,
          # nothing in subdomain mode) must be included here too or this 404s.
          uri: "http://{{ keycloak_route.backend }}.{{ keycloak_route.namespace }}.svc.cluster.local:{{ keycloak_route.port }}{{ '' if keycloak_route.relative_path == '/' else keycloak_route.relative_path }}/realms/{{ keycloak_realm }}/protocol/openid-connect/certs"
{% elif auth_provider == 'litellm' %}
  extAuth:
    http:
      backendRef:
        name: litellm
        namespace: litellm
        port: 4000
      headersToBackend:
        - Authorization
      path: /key/verify
{% endif %}
