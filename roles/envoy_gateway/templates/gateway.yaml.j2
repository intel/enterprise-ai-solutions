---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: {{ gateway_name }}
  namespace: {{ gateway_namespace }}
spec:
  gatewayClassName: eg
  # Solutions publish their hosts in ListenerSets; only labelled namespaces
  # may attach one (the admission policy checks each host is granted).
  allowedListeners:
    namespaces:
      from: Selector
      selector:
        matchLabels:
          {{ gateway_listeners_label_key }}: {{ gateway_listeners_label_value | to_json }}
  listeners:
    # Plaintext :80 only redirects to HTTPS; the redirect route lives here, so
    # no other namespace can claim a host before the redirect.
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: Same
{% if gateway_wildcard_listener_enabled | bool %}
    # Legacy catch-all for routes not yet on a ListenerSet (HTTP/1.1 only, see
    # gateway_wildcard_listener_enabled). More specific listeners win.
    - name: https
      protocol: HTTPS
      port: 443
      hostname: "*.{{ base_domain_name }}"
      tls:
        mode: Terminate
        certificateRefs:
          - kind: Secret
            name: {{ gateway_wildcard_tls_secret_name if gateway_tls_mode == 'selfsigned' else gateway_tls_secret_name }}
      allowedRoutes:
        namespaces:
          from: All
{% endif %}
    # Apex listener — the bare base_domain_name (e.g. a landing UI).
    - name: https-apex
      protocol: HTTPS
      port: 443
      hostname: "{{ base_domain_name }}"
      tls:
        mode: Terminate
        certificateRefs:
          - kind: Secret
            name: {{ gateway_tls_secret_name }}
      allowedRoutes:
        namespaces:
          from: All
{% if gateway_s3_listener_enabled | bool %}
    # S3 API listener. Its only purpose is to carry the ClientTrafficPolicy
    # that turns off merge_slashes and %2F rewriting, which SigV4 needs and
    # which must NOT be turned off for the other listeners.
    - name: {{ gateway_s3_listener_name }}
      protocol: HTTPS
      port: 443
      hostname: "{{ gateway_s3_hostname }}"
      tls:
        mode: Terminate
        certificateRefs:
          - kind: Secret
            name: {{ gateway_s3_tls_secret_name if gateway_tls_mode == 'selfsigned' else gateway_tls_secret_name }}
      allowedRoutes:
        namespaces:
          from: All
{% endif %}
