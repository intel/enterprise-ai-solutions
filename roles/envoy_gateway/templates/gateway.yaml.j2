---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: {{ gateway_name }}
  namespace: {{ gateway_namespace }}
spec:
  gatewayClassName: eg
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: All
{% for l in gateway_service_listeners %}
    # {{ l.hostname }}: exact host from the service registry; only its owning
    # namespace may attach (no wildcard listener).
    - name: {{ l.name }}
      protocol: HTTPS
      port: 443
      hostname: {{ l.hostname | to_json }}
      tls:
        mode: Terminate
        certificateRefs:
          - kind: Secret
            name: {{ gateway_tls_secret_name }}
      allowedRoutes:
        namespaces:
          from: Selector
          selector:
            matchLabels:
              kubernetes.io/metadata.name: {{ l.namespace | to_json }}
{% endfor %}
    # Apex listener (bare base_domain_name). In routing_mode: path every platform
    # service shares this host, told apart only by path, so it is NOT `from: All`:
    # an open apex would let any namespace claim a more-specific apex path (e.g.
    # /keycloak/...) and hijack platform traffic + tokens. Only namespaces a
    # platform role has labelled may attach.
    - name: https-apex
      protocol: HTTPS
      port: 443
      hostname: "{{ base_domain_name }}"
      tls:
        mode: Terminate
        certificateRefs:
          - kind: Secret
            name: {{ gateway_tls_secret_name }}
      allowedRoutes:
        namespaces:
          from: Selector
          selector:
            matchLabels:
              "{{ gateway_apex_route_label_key }}": "{{ gateway_apex_route_label_value }}"
{% if gateway_s3_listener_enabled | bool %}
    # S3 API listener (exact host). Its own listener only to carry the
    # ClientTrafficPolicy that turns off merge_slashes and %2F rewriting, which
    # SigV4 needs and which must NOT be turned off for the other listeners.
    - name: {{ gateway_s3_listener_name }}
      protocol: HTTPS
      port: 443
      hostname: "{{ gateway_s3_hostname }}"
      tls:
        mode: Terminate
        certificateRefs:
          - kind: Secret
            name: {{ gateway_tls_secret_name }}
      allowedRoutes:
        namespaces:
          from: All
{% endif %}
