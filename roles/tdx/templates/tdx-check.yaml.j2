apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: one-td-support-checks
  namespace: tdx-system
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: one-td-support-checks
  template:
    metadata:
      labels:
        app.kubernetes.io/name: one-td-support-checks
    spec:
      nodeSelector: {{ tdx_node_selector | default({}) | to_json }}
      containers:
        - name: one-td-support-checks
          image: busybox:1.36
          imagePullPolicy: IfNotPresent
          securityContext:
            privileged: true
            runAsUser: 0
          command:
            - /bin/sh
            - -ec
            - |
              echo "Checking TDX support on node..."
              echo ""

              kernel_config="/host/boot/config-$(uname -r)"
              if ! grep -Eq 'CONFIG_(INTEL_)?TDX_GUEST=y' "$kernel_config"; then
                echo "ERROR: The node's kernel does not support TDX." >&2
                exit 1
              fi
              echo "OK: TDX guest support is enabled in the node's kernel."

              if ! test -e /host/dev/tdx_guest; then
                echo "ERROR: The TDX guest device is absent on the node." >&2
                exit 1
              fi
              echo "OK: The TDX guest device is present on the node."

              echo ""
              echo "TDX guest checks passed."
              touch /tmp/tdx-support-check-passed
              while :; do sleep 3600; done
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -ec
                - test -f /tmp/tdx-support-check-passed
            periodSeconds: 5
          volumeMounts:
            - name: host-boot
              mountPath: /host/boot
              readOnly: true
            - name: host-dev
              mountPath: /host/dev
              readOnly: true
      volumes:
        - name: host-boot
          hostPath:
            path: /boot
            type: Directory
        - name: host-dev
          hostPath:
            path: /dev
            type: Directory
