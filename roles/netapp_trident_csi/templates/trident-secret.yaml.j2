`data:` + `| b64encode`, not `stringData:`. An ONTAP password is arbitrary text:
it can contain ": ", start with a YAML indicator, read as a bool/int, or hold a
code point above the BMP that to_json would emit as an invalid surrogate escape.
base64 is UTF-8 in, ASCII out, so none of that can break the manifest.
#}
apiVersion: v1
kind: Secret
metadata:
  name: {{ (trident_backend_name ~ '-secret') | to_json }}
  namespace: {{ trident_namespace | to_json }}
type: Opaque
data:
  username: {{ ontap_username | string | b64encode | to_json }}
  password: {{ ontap_password | string | b64encode | to_json }}
