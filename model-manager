#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export MM_REPO_ROOT="$SCRIPT_DIR"

# Resolve target environment under env/
if [[ -z "${ES_ENV:-}" ]]; then
    mapfile -t available_envs < <(find "${SCRIPT_DIR}/env" -mindepth 1 -maxdepth 1 -type d -printf '%f
' 2>/dev/null | sort)
    if [[ ${#available_envs[@]} -eq 1 ]]; then
        ES_ENV="${available_envs[0]}"
        echo "[INFO] Using environment: ${ES_ENV}" >&2
    else
        ES_ENV="local"
    fi
fi
export ES_ENV
ENV_DIR="${SCRIPT_DIR}/env/${ES_ENV}"

if [[ -f "${ENV_DIR}/kubeconfig.yaml" && -z "${KUBECONFIG:-}" ]]; then
    export KUBECONFIG="${ENV_DIR}/kubeconfig.yaml"
fi
if [[ -f "${ENV_DIR}/global_config.yaml" ]]; then
    export MM_GLOBAL_CONFIG="${ENV_DIR}/global_config.yaml"
fi
if [[ -f "${ENV_DIR}/models.yaml" ]]; then
    export MM_CONFIG="${MM_CONFIG:-${ENV_DIR}/models.yaml}"
fi

PY_BIN="python3"
if [[ -x "${SCRIPT_DIR}/.venv/bin/python3" ]]; then
    PY_BIN="${SCRIPT_DIR}/.venv/bin/python3"
fi

export PYTHONPATH="${SCRIPT_DIR}/ext/enterprise.ai-inference/model_manager:${SCRIPT_DIR}/ext/enterprise.ai-inference/model_manager/scripts:${PYTHONPATH:-}"
exec "$PY_BIN" -m core "$@"
